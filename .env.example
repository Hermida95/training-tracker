# -------- Postgres (local docker-compose) --------
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=training_tracker
POSTGRES_PORT=5432

# -------- Backend --------
# Usada por SQLAlchemy. En docker-compose el host es el nombre del servicio "db".
DATABASE_URL=postgresql+psycopg://trainer:trainer@db:5432/training_tracker
# Zona horaria fija para toda la lógica de fechas/streaks/alarma antisedentarismo
APP_TIMEZONE=Europe/Madrid
# Orígenes permitidos para CORS (separados por coma). En prod: URL del front en Cloud Run.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENVIRONMENT=local

# -------- Alarma antisedentarismo (valores por defecto, configurables en /settings) --------
BREAK_INTERVAL_MINUTES=45
BREAK_WINDOW_START=08:30
BREAK_WINDOW_END=15:00

# -------- Frontend (Vite, deben empezar por VITE_) --------
VITE_API_BASE_URL=http://localhost:8000/api/v1
